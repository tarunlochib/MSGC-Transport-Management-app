# Production Environment Variables for Vercel
# Copy this to .env.local and fill in your values
# Note: This is an internal MSGC application - no public signup available

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# JWT Secret (generate a strong secret for internal staff authentication)
JWT_SECRET="your-super-secure-jwt-secret-here"

# Environment
NODE_ENV="production"

# CORS Origin (your Vercel app URL)
CORS_ORIGIN="https://your-app.vercel.app"

# Optional: Prisma Debug (set to "true" for debugging)
PRISMA_DEBUG="false"
