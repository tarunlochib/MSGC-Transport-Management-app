generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities UserActivity[]

  @@map("users")
}

model Company {
  id              String   @id @default(cuid())
  name            String
  address         String
  city            String?
  state           String?
  pincode         String?
  phone           String?
  email           String?
  gstNumber       String?
  panNumber       String?
  website         String?
  logo            String?
  bankName        String?
  bankAccount     String?
  ifscCode        String?
  termsAndConditions String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("companies")
}

model Customer {
  id                String    @id @default(cuid())
  name              String
  address           String
  gstNumber         String
  panNumber         String?
  phone             String?
  email             String?
  contactPerson     String?
  alternatePhone    String?
  customerType      String    @default("Regular")
  creditLimit       Float?
  paymentTerms      String?
  status            String    @default("Active")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  consigneeBookings Booking[] @relation("ConsigneeBookings")
  consignorBookings Booking[] @relation("ConsignorBookings")

  @@map("customers")
}

model Transporter {
  id             String    @id @default(cuid())
  name           String
  address        String?
  phone          String?
  commissionRate Float
  contactInfo    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]
  vehicles       Vehicle[]
  challans       Challan[]
  income         Income[]
  godowns        Godown[]

  @@map("transporters")
}

model Vehicle {
  id                 String       @id @default(cuid())
  vehicleNumber      String       @unique
  make               String?
  model              String?
  registrationNumber String?
  driverName         String?
  status             String       @default("Active")
  capacity           Float?
  year               Int?
  fuelType           String       @default("Diesel")
  insuranceNumber    String?
  insuranceExpiry    DateTime?
  permitExpiry       DateTime?
  fitnessExpiry      DateTime?
  pucExpiry          DateTime?
  notes              String?
  isOwned            Boolean      @default(true)
  transporterId      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  bookings           Booking[]
  driver             Driver?
  expenses           Expense[]
  challans           Challan[]
  transporter        Transporter? @relation(fields: [transporterId], references: [id])

  @@map("vehicles")
}

model Driver {
  id                String    @id @default(cuid())
  name              String
  phone             String
  email             String?
  address           String?
  licenseNumber     String    @unique
  licenseExpiry     DateTime?
  permitExpiry      DateTime?
  medicalExpiry     DateTime?
  status            String    @default("Active")
  experience        Int?
  salary            Float?
  emergencyContact  String?
  emergencyPhone    String?
  bloodGroup        String?
  vehicleId         String?   @unique
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
  vehicle           Vehicle?  @relation(fields: [vehicleId], references: [id])
  challans          Challan[]

  @@map("drivers")
}

model Booking {
  id                  String      @id @default(cuid())
  grNumber            String      @unique
  bookingDate         DateTime
  consignorName       String
  consignorAddress    String
  consignorGST        String?
  consigneeName       String
  consigneeAddress    String
  consigneeGST        String?
  fromLocation        String
  toLocation          String
  ewayBill            String?
  paymentMethod       String
  paymentType         String?     // Cash, UPI, Cheque (only when paymentMethod is "Paid")
  totalAmount         Float
  paidAmount          Float       @default(0)
  deliveryAgainst     String
  weightKg            Float       @default(0)
  freightCharges      Float       @default(0)
  localCartageCharges Float       @default(0)
  doorDeliveryCharges Float       @default(0)
  stationaryCharges   Float       @default(0)
  labourCharges       Float       @default(0)
  otherCharges        Float       @default(0)
  totalCharges        Float       @default(0)
  transporterId       String
  vehicleId           String?
  driverId            String?
  consignorId         String?
  consigneeId         String?
  godownId            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  privateMarka        String?
  consignee           Customer?   @relation("ConsigneeBookings", fields: [consigneeId], references: [id])
  consignor           Customer?   @relation("ConsignorBookings", fields: [consignorId], references: [id])
  driver              Driver?     @relation(fields: [driverId], references: [id])
  vehicle             Vehicle?    @relation(fields: [vehicleId], references: [id])
  transporter         Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  godown              Godown?     @relation(fields: [godownId], references: [id])
  invoices            Invoice[]
  packages            Package[]
  challanGoods        ChallanGoods[]

  @@map("bookings")
}

model Package {
  id              String   @id @default(cuid())
  bookingId       String
  numberOfItems   Int
  packagingType   String
  itemDescription String?
  weightKg        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("packages")
}

model Invoice {
  id           String   @id @default(cuid())
  bookingId    String
  invoiceNo    String
  invoiceValue Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Expense {
  id             String   @id @default(cuid())
  date           DateTime
  expenseType    String
  amount         Float
  description    String?
  vehicleId      String?
  location       String?
  receiptNumber  String?
  paymentMethod  String   @default("cash")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("expenses")
}

model Challan {
  id                String         @id @default(cuid())
  challanNumber     String         @unique
  dateGenerated     DateTime       @default(now())
  transportCompanyId String
  truckId           String
  driverId          String
  fromLocation      String
  toLocation        String
  totalPackages     Int            @default(0)
  totalWeight       Float          @default(0)
  totalCharges      Float          @default(0)
  status            String         @default("Generated")
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  transportCompany  Transporter    @relation(fields: [transportCompanyId], references: [id])
  truck             Vehicle        @relation(fields: [truckId], references: [id])
  driver            Driver         @relation(fields: [driverId], references: [id])
  challanGoods      ChallanGoods[]

  @@map("challans")
}

model ChallanGoods {
  id                 String   @id @default(cuid())
  challanId          String
  bookingId          String
  serialNumber       Int
  packages           Int      @default(0)
  weight             Float    @default(0)
  destinationLocation String
  charges            Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  challan            Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  booking            Booking  @relation(fields: [bookingId], references: [id])

  @@map("challan_goods")
}

model Income {
  id              String   @id @default(cuid())
  date            DateTime
  amount          Float
  source          String
  description     String?
  category        String
  paymentMethod   String   @default("cash")
  referenceNumber String?
  status          String   @default("Received")
  transporterId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  transporter     Transporter? @relation(fields: [transporterId], references: [id])

  @@map("income")
}

model Godown {
  id            String   @id @default(cuid())
  name          String
  transporterId String
  cities        String   // JSON string of cities array
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transporter   Transporter @relation(fields: [transporterId], references: [id])
  bookings      Booking[]

  @@map("godowns")
}

model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  type        String   // booking, challan, customer, transporter, expense, settings, login
  action      String   // Created booking, Generated challan, etc.
  details     String   // Additional details about the activity
  metadata    String?  // JSON string for additional data
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activities")
}