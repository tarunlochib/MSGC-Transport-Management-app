{
  "version": 2,
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs22.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/MSGC.png",
      "dest": "/MSGC.png"
    },
    {
      "src": "/MSGC_Transparent.png",
      "dest": "/MSGC_Transparent.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
